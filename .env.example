# Copy to .env and change every value marked CHANGE_ME.

# --- PostgreSQL ---
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=appdb
DATABASE_URL=postgresql+psycopg2://appuser:CHANGE_ME_db_password@db:5432/appdb

# --- Auth / tokens ---
SECRET_KEY=CHANGE_ME_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30
VERIFY_TOKEN_EXPIRE_HOURS=24
COOKIE_SECURE=false          # set true behind HTTPS

# --- First admin (seeded on startup) ---
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=CHANGE_ME_admin_password

# --- Email (Mailpit in development) ---
FRONTEND_URL=http://localhost
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# --- Redis / rate limiting ---
REDIS_URL=redis://redis:6379/0
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900

# --- pgAdmin ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME_pgadmin_password

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_grafana_password

BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=7
